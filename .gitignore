.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Node (rules unit tests)
rules_tests/node_modules/
rules_tests/firebase-debug.log
rules_tests/firestore-debug.log
*.log
.firebase/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

.superpowers/

# Firebase secrets (never commit service accounts)
**/serviceAccount*.json
functions/node_modules/
functions/lib/

# Android release signing (never commit)
android/key.properties
android/**/*.jks
android/**/*.keystore

# Gradle build output (not source)
/android/build/

# Per-flavor Firebase client config: release process copies the *-prod /
# *-Prod variant over the default before a store build (see README). Keep
# these out of git so that manual-copy step can't silently drift or leak
# which project a given checkout is pointed at.
android/app/google-services.json
android/app/google-services-prod.json
ios/Runner/GoogleService-Info.plist
ios/Runner/GoogleService-Info-Prod.plist

# Local env overrides (committed .env.<project> files are non-secret flags only)
functions/.env.local
.env
.env.*
!.env.example
!functions/.env.emo-sup-staging
!functions/.env.emo-sup-prod

