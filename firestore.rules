rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Prefer Firebase Auth custom claim `role: "listener"` (Admin SDK after vetting).
    function isListener() {
      return signedIn()
        && request.auth.token.role == 'listener';
    }

    function chatDoc(sessionId) {
      return get(/databases/$(database)/documents/chats/$(sessionId)).data;
    }

    function isChatParticipant(sessionId) {
      let c = chatDoc(sessionId);
      return signedIn()
        && (request.auth.uid == c.userId || request.auth.uid == c.listenerId);
    }

    // Client-writable keys on users/{uid} (no PII, no server-only flags).
    function userClientCreateKeysOk() {
      return request.resource.data.keys().hasOnly([
        'uid', 'anonymousName', 'authMethod', 'createdAt',
        'preferredLanguages', 'locale', 'discreetMode', 'region',
        'lastMoodValue', 'lastMoodAt'
      ]);
    }

    function userClientUpdateKeysOk() {
      // May not touch server-only or identity immutables.
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'uid', 'createdAt', 'deletionRequestedAt',
          'email', 'phone', 'legalName'
        ]);
    }

    // ── users ─────────────────────────────────────────────
    match /users/{uid} {
      allow list: if false;

      allow get: if isSelf(uid);

      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && userClientCreateKeysOk()
        && !('email' in request.resource.data)
        && !('phone' in request.resource.data)
        && !('legalName' in request.resource.data)
        && !('deletionRequestedAt' in request.resource.data);

      allow update: if isSelf(uid)
        && request.resource.data.uid == uid
        && userClientUpdateKeysOk()
        && !('email' in request.resource.data)
        && !('phone' in request.resource.data)
        && !('legalName' in request.resource.data);

      // Delete-my-data is CF-mediated in production; deny client delete of profile.
      allow delete: if false;

      match /mood_entries/{entryId} {
        allow list, get: if isSelf(uid);
        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['timestamp', 'value'])
          && request.resource.data.value is int
          && request.resource.data.value >= 1
          && request.resource.data.value <= 5;
        allow update, delete: if isSelf(uid);
      }

      // FCM device tokens (client manages own tokens).
      match /fcm_tokens/{tokenId} {
        allow read, write: if isSelf(uid);
      }

      // Free-match weekly quota — CF writes only (PR 10).
      match /match_quota/{weekId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    // ── listener_public (directory projection; PR 8) ──────
    // Safe fields only: id, displayName, bio, languages, availableNow, tier.
    match /listener_public/{listenerId} {
      allow list, get: if signedIn();
      // Writes: Admin SDK / Cloud Functions only (projection from private doc).
      allow create, update, delete: if false;
    }

    // ── listeners (private / ops — not open list) ─────────
    match /listeners/{listenerId} {
      // Directory uses listener_public. Private docs for the listener self only.
      allow list: if false;
      allow get: if isListener() && isSelf(listenerId);
      allow create, update: if isListener() && isSelf(listenerId);
      allow delete: if false;

      // Availability slots: read for signed-in (booking UI); writes CF-only (PR 13).
      match /availability/{slotId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // ── chats + messages ──────────────────────────────────
    match /chats/{sessionId} {
      allow list: if signedIn() && (
        resource.data.userId == request.auth.uid
        || (isListener() && resource.data.listenerId == request.auth.uid)
      );

      allow get: if signedIn()
        && (resource.data.userId == request.auth.uid
            || (isListener() && resource.data.listenerId == request.auth.uid));

      // PR 10: matchmaking is CF-only — clients cannot invent sessions.
      allow create: if false;

      allow update: if signedIn()
        && (resource.data.userId == request.auth.uid
            || (isListener() && resource.data.listenerId == request.auth.uid))
        && !request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasAny([
              'userId', 'listenerId', 'startedAt',
              'quotaCharged', 'quotaWeekId', 'quotaRefunded'
            ]);

      allow delete: if false;

      match /messages/{messageId} {
        allow list, get: if isChatParticipant(sessionId);

        allow create: if isChatParticipant(sessionId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasAll([
               'senderId', 'text', 'timestamp', 'status'
             ])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() < 4000;

        allow update: if isChatParticipant(sessionId)
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.text == resource.data.text
          && request.resource.data.timestamp == resource.data.timestamp;

        allow delete: if false;
      }
    }

    // ── bookings (PR 9: server-only writes) ────────────────
    match /bookings/{bookingId} {
      allow list: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || (isListener() && resource.data.listenerId == request.auth.uid)
        );

      allow get: if signedIn()
        && (resource.data.userId == request.auth.uid
            || (isListener() && resource.data.listenerId == request.auth.uid));

      // createBookingCheckout / cancelBooking / webhooks only.
      allow create, update, delete: if false;
    }

    // ── free match config (optional client read) ──────────
    match /config/{docId} {
      allow get: if signedIn() && docId in ['free_match', 'async', 'booking'];
      allow list, create, update, delete: if false;
    }

    // ── memberships (PR 22: server write only) ────────────
    match /memberships/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;
      // activate via payment webhook / MembershipActivation CF only
      allow create, update, delete: if false;
    }

    // ── reports (write-once for submitter) ─────────────────
    match /reports/{reportId} {
      allow list, get: if false;

      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.keys().hasAll([
             'reporterId', 'targetType', 'targetId', 'reason', 'createdAt', 'status'
           ])
        && request.resource.data.status == 'open'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() < 200
        && (
          !('details' in request.resource.data)
          || request.resource.data.details.size() < 2000
        );

      allow update, delete: if false;
    }

    // ── blocks (create by blocker; reads for UI bilateral later) ──
    match /blocks/{blockId} {
      allow get: if signedIn()
        && (resource.data.blockerId == request.auth.uid
            || resource.data.blockedId == request.auth.uid);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.keys().hasAll([
             'blockerId', 'blockedId', 'createdAt'
           ]);
      allow update, delete: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
